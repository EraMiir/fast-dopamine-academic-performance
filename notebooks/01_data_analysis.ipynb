import json
import numpy as np
import pandas as pd
from scipy.stats import wilcoxon

SEED = 42
np.random.seed(SEED)

with open("../data/raw/test_run.jsonl", "r", encoding="utf-8") as f:
    raw_records = [json.loads(line) for line in f if line.strip()]

df_raw = pd.DataFrame(raw_records)
df_eval = df_raw[df_raw["phase"] == "evaluation"].copy()

print(f"Всего записей в test_run.jsonl: {len(df_raw)}")
print(f"Прогревочных записей (warmup): {sum(df_raw['phase'] == 'warmup')}")
print(f"Оценочных записей (evaluation): {len(df_eval)}")
assert len(df_raw) == 276, "Ожидалось 276 записей!"
assert len(df_eval) == 240, "Ожидалось 240 evaluation-записей!"

df_summary = pd.read_csv("../data/processed/metrics_summary.csv")
assert (df_summary["n_runs"] == 20).all(), "Для каждой комбинации должно быть ровно 20 прогонов!"
display(df_summary[[
    "model", "sample_size", "n_runs",
    "RMSE_median", "RMSE_iqr", "RMSE_ci_low", "RMSE_ci_high",
    "RMSE_diff_mean", "RMSE_diff_ci_low", "RMSE_diff_ci_high",
    "wilcoxon_p_value", "latency_ms_median", "error_rate"
]])
